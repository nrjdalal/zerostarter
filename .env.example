NODE_ENV=local

# `bun run dev` serves named portless `.localhost` URLs (branch-prefixed in a worktree) and sets `HONO_APP_URL`, `HONO_TRUSTED_ORIGINS`, `NEXT_PUBLIC_API_URL` and `NEXT_PUBLIC_APP_URL` to them itself, so the values below for those four apply only under `PORTLESS=0` (the plain localhost ports), in Docker and on a deploy.

# -------------------- Server variables --------------------

HONO_APP_URL=http://localhost:4000
HONO_TRUSTED_ORIGINS=http://localhost:3000
HONO_RATE_LIMIT=60 # requests per address per window (default); signed-in /api/v1 requests also get a per-user budget of twice this
HONO_RATE_LIMIT_WINDOW_MS=60000 # 1 minute (default)

# Generate using `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Optional (local dev only): set to `true` to enable the agent sign-in route (`/api/agents/sign-in-as`), which signs in as `LocalAgent` for AI-agent testing, an owner from the call that creates that account until someone demotes it; `init` and `reinit` turn a blank or missing value into `true`. The route mounts while this is `true` and `NODE_ENV=local`, the api listens on every network interface, and its trusted-Origin check stops only browser pages on other sites, so any host that reaches the api port can call it. A `.env` a deploy reads (Docker's included) sets this to `false` and `NODE_ENV` to `production` or `staging`.
AGENT_SIGNIN_ENABLED=

# Optional: GitHub OAuth (`https://github.com/settings/developers`). Leave blank to hide the button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Google OAuth (`https://console.cloud.google.com/apis/credentials`). Leave blank to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate using `bunx pglaunch@5.5.7 -k`
POSTGRES_URL=

# -------------------- Client variables --------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: PostHog Analytics (https://zerostarter.dev/docs/manage/analytics)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Optional: User feedback (https://zerostarter.dev/docs/manage/analytics)
NEXT_PUBLIC_USERJOT_URL=
