{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.3.14",
  "images": {
    "sizes": [16, 32, 48, 64, 96, 128, 256, 384, 640, 750, 828, 1080, 1200, 1920, 2048, 3840],
    "qualities": [75],
    "formats": ["image/webp"],
    "localPatterns": [{ "pathname": "^/.*$", "search": "" }],
    "remotePatterns": []
  },
  "services": {
    "web": {
      "root": "web/next/",
      "framework": "nextjs",
      "installCommand": "cd ../.. && bun install --ignore-scripts",
      "buildCommand": "cd ../.. && turbo build --filter=@web/next"
    },
    "api": {
      "root": "api/hono/",
      "framework": "hono",
      "installCommand": "cd ../.. && bun install --ignore-scripts",
      "buildCommand": "cd ../.. && turbo build --filter=@api/hono",
      "outputDirectory": "bundle"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "api.poc.zerostarter.dev" }],
      "destination": { "service": "api" }
    },
    { "source": "/((?!_next/image|_vercel/image).*)", "destination": { "service": "web" } }
  ]
}
