    "react-resizable-panels": "^4.21.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "takumi-js": "^2.20.0",
    "tldts": "^7.4.21",
    "ts-morph": "^28.0.0",
