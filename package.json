{
  "name": "zerostarter",
  "version": "0.1.44",
  "private": true,
  "homepage": "https://github.com/nrjdalal/zerostarter#readme",
  "bugs": "https://github.com/nrjdalal/zerostarter/issues",
  "license": "MIT",
  "author": {
    "name": "Neeraj Dalal",
    "email": "admin@nrjdalal.com",
    "url": "https://nrjdalal.com"
  },
  "repository": "nrjdalal/zerostarter",
  "funding": "https://github.com/sponsors/nrjdalal",
  "workspaces": [
    "api/*",
    "packages/*",
    "web/*"
  ],
  "scripts": {
    "auth:schema": "bun packages/scripts/src/auth-schema.ts",
    "build": "turbo run build --summarize && bun packages/scripts/src/build-sizes.ts",
    "check-types": "turbo run check-types --summarize && bun run check-types:tests",
    "check-types:tests": "if [ -d tests ]; then find tests -name tsconfig.json -print0 | xargs -0 -n1 tsrs -p; fi",
    "clean": "bun packages/scripts/src/clean.ts",
    "console:roles": "bun packages/scripts/src/console-roles.ts",
    "db:generate": "turbo run build --filter=@packages/env && bun --cwd packages/db drizzle-kit generate",
    "db:migrate": "turbo run build --filter=@packages/env && bun --cwd packages/db drizzle-kit migrate",
    "db:studio": "turbo run build --filter=@packages/env && bun --cwd packages/db drizzle-kit studio",
    "dev": "PORTLESS_HTTPS=0 PORTLESS_PORT=1355 PORTLESS_SYNC_HOSTS=0 turbo run dev",
    "devtools": "turbo devtools",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "postinstall": "bun packages/scripts/src/deps-manager.ts",
    "prepare": "bunx lefthook install",
    "release:version": "bun packages/scripts/src/release-version.ts",
    "start": "turbo run start",
    "sync:config": "bun packages/scripts/src/sync-config.ts",
    "sync:shadcn": "bun packages/scripts/src/shadcn-update.ts && bun i",
    "test": "if [ -d tests ]; then turbo run build --filter='./packages/*' && bun packages/scripts/src/data-table-metrics.ts && bun test tests; fi",
    "test:e2e": "[ ! -d tests ] || E2E_API_URL=${E2E_API_URL:-http://localhost:4000} E2E_WEB_URL=${E2E_WEB_URL:-http://localhost:3000} bun test e2e.test"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "changelogen": "catalog:",
    "globby": "catalog:",
    "lefthook": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "portless": "catalog:",
    "tsrs": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "@arcjet/ip": "^1.15.0",
    "@base-ui/react": "^1.9.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@hono/node-server": "^2.1.6",
    "@hono/standard-validator": "^0.4.1",
    "@octokit/rest": "^22.0.1",
    "@remixicon/react": "^4.9.0",
    "@scalar/hono-api-reference": "^0.12.19",
    "@shadcn/react": "^0.3.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@takumi-rs/core-darwin-arm64": "^2.20.0",
    "@takumi-rs/core-darwin-x64": "^2.20.0",
    "@takumi-rs/core-linux-arm64-gnu": "^2.20.0",
    "@takumi-rs/core-linux-arm64-musl": "^2.20.0",
